{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "YokaiWatch1Recomp",
  "repo": "YokaiWatch1Recomp/YokaiWatch1Recomp",
  "inputs": [
    {
      "id": "game",
      "label": "Your extracted copy of Yo-kai Watch 1 (Nintendo Switch, Title ID 0100C0000CEEA000; tested on v1.3.0, universal support for v1.0.0/v1.4.0+): the folder containing exefs/main and romfs/.",
      "role": "game",
      "formats": [
        {
          "type": "folder"
        }
      ],
      "check": {
        "file": "exefs/main"
      },
      "optional": false
    }
  ],
  "start": {
    "program": [
      "YokaiWatch1Recomp.exe"
    ],
    "args": [
      "--game-dir",
      "{input:game}",
      "--play"
    ],
    "env": {
      "LARECOMP_DATA_ROOT": "{data}"
    }
  },
  "prepare": {
    "program": [
      "YokaiWatch1Recomp.exe"
    ],
    "args": [
      "--game-dir",
      "{input:game}",
      "--build-only"
    ],
    "label": "Recompiling game modules into native PC code",
    "done": [
      "{data}/.gamebuild/gamelib_entry.receipt"
    ],
    "env": {
      "LARECOMP_DATA_ROOT": "{data}"
    },
    "keeps_copy": false
  },
  "config": [
    {
      "id": "main",
      "format": "ini",
      "file": [
        {
          "path": "{data}/yokaiwatch1.ini"
        }
      ],
      "game_path": "game_dir",
      "new": {
        "game_lang": "auto",
        "background_input": "0"
      }
    }
  ],
  "saves": [
    "{data}/save"
  ],
  "folders": {
    "saves": [
      {
        "path": "{data}/save"
      }
    ],
    "logs": [
      {
        "path": "{install}"
      }
    ],
    "data": [
      {
        "path": "{data}"
      }
    ],
    "mods": [
      {
        "path": "{data}/mods"
      }
    ]
  },
  "system": {
    "windows": {
      "version": "10"
    }
  },
  "groups": [
    {
      "id": "Advanced",
      "advanced": true
    }
  ],
  "settings": [
    {
      "id": "window_mode",
      "label": "Window",
      "group": "Display",
      "help": "Windowed runs in a movable window. Borderless fills the screen cleanly; Exclusive takes over the display.",
      "choices": [
        {
          "label": "Windowed",
          "set": {
            "window_mode": "windowed",
            "fullscreen": "0"
          }
        },
        {
          "label": "Borderless Fullscreen",
          "set": {
            "window_mode": "borderless",
            "fullscreen": "1"
          }
        },
        {
          "label": "Exclusive Fullscreen",
          "set": {
            "window_mode": "exclusive",
            "fullscreen": "1"
          }
        }
      ],
      "defaults": {
        "window_mode": "windowed",
        "fullscreen": "0"
      },
      "in": "main",
      "advanced": false
    },
    {
      "id": "output_res",
      "label": "Output resolution",
      "group": "Display",
      "help": "Target display/window output resolution. Auto matches your current screen or window size.",
      "choices": [
        {
          "label": "Auto",
          "set": {
            "output_res": "auto"
          }
        },
        {
          "label": "720p",
          "set": {
            "output_res": "720p"
          }
        },
        {
          "label": "1080p",
          "set": {
            "output_res": "1080p"
          }
        },
        {
          "label": "1440p",
          "set": {
            "output_res": "1440p"
          }
        },
        {
          "label": "4K",
          "set": {
            "output_res": "4k"
          }
        }
      ],
      "defaults": {
        "output_res": "auto"
      },
      "in": "main",
      "advanced": false
    },
    {
      "id": "aspect_mode",
      "label": "Aspect ratio",
      "group": "Display",
      "help": "Keeps the original 16:9 framing or stretches to fill non-16:9 displays.",
      "choices": [
        {
          "label": "16:9",
          "set": {
            "aspect_mode": "16:9"
          }
        },
        {
          "label": "Stretch",
          "set": {
            "aspect_mode": "stretch"
          }
        }
      ],
      "defaults": {
        "aspect_mode": "16:9"
      },
      "in": "main",
      "advanced": false
    },
    {
      "id": "vsync_mode",
      "label": "V-Sync",
      "group": "Display",
      "help": "Mailbox gives smooth frames without tearing and low latency. FIFO caps to refresh rate; Immediate minimizes latency.",
      "choices": [
        {
          "label": "Mailbox (Fast)",
          "set": {
            "vsync_mode": "mailbox"
          }
        },
        {
          "label": "FIFO (On)",
          "set": {
            "vsync_mode": "fifo"
          }
        },
        {
          "label": "Immediate (Off)",
          "set": {
            "vsync_mode": "immediate"
          }
        }
      ],
      "defaults": {
        "vsync_mode": "mailbox"
      },
      "in": "main",
      "advanced": false
    },
    {
      "id": "res_scale",
      "label": "Internal resolution scale",
      "group": "Display",
      "help": "Internal OpenGL 3D framebuffer scale relative to the Switch 1080p render target. Higher scales sharpen 3D geometry.",
      "choices": [
        {
          "label": "1x (1080p)",
          "set": {
            "res_scale": "1x"
          }
        },
        {
          "label": "1.5x (1620p)",
          "set": {
            "res_scale": "1.5x"
          }
        },
        {
          "label": "2x (4K 2160p)",
          "set": {
            "res_scale": "2x"
          }
        }
      ],
      "defaults": {
        "res_scale": "1x"
      },
      "in": "main",
      "advanced": false
    },
    {
      "id": "game_speed",
      "label": "Game speed",
      "group": "Display",
      "help": "Adjusts real-time game speed multiplier (1.0x to 3.0x; F3 cycles in-game).",
      "choices": [
        {
          "label": "1.0x (Normal)",
          "set": {
            "game_speed": "1.0x"
          }
        },
        {
          "label": "1.5x",
          "set": {
            "game_speed": "1.5x"
          }
        },
        {
          "label": "2.0x",
          "set": {
            "game_speed": "2.0x"
          }
        },
        {
          "label": "3.0x",
          "set": {
            "game_speed": "3.0x"
          }
        }
      ],
      "defaults": {
        "game_speed": "1.0x"
      },
      "in": "main",
      "advanced": false
    },
    {
      "id": "hud_mode",
      "label": "Performance overlay",
      "group": "Display",
      "help": "Shows a frame-rate counter or detailed timing overlay in the corner.",
      "choices": [
        {
          "label": "Off",
          "set": {
            "hud_mode": "off",
            "show_fps": "0"
          }
        },
        {
          "label": "FPS",
          "set": {
            "hud_mode": "fps",
            "show_fps": "1"
          }
        },
        {
          "label": "Detailed",
          "set": {
            "hud_mode": "detailed",
            "show_fps": "1"
          }
        }
      ],
      "defaults": {
        "hud_mode": "off",
        "show_fps": "0"
      },
      "in": "main",
      "advanced": false
    },
    {
      "id": "mods_enabled",
      "label": "Mods (LayeredFS)",
      "group": "Advanced",
      "help": "Enables RomFS/ExeFS mod overrides loaded from the mods/ folder.",
      "choices": [
        {
          "label": "On",
          "set": {
            "mods_enabled": "1"
          }
        },
        {
          "label": "Off",
          "set": {
            "mods_enabled": "0"
          }
        }
      ],
      "defaults": {
        "mods_enabled": "1"
      },
      "in": "main",
      "advanced": true
    },
    {
      "id": "volume",
      "label": "Master volume",
      "group": "Audio",
      "help": "Overall audio level (0.00 to 1.00).",
      "slider": {
        "key": "volume",
        "min": 0.0,
        "max": 1.0,
        "step": 0.05,
        "format": "%.2f"
      },
      "defaults": {
        "volume": "1.00"
      },
      "in": "main",
      "advanced": false
    },
    {
      "id": "mute_unfocused",
      "label": "Mute when unfocused",
      "group": "Audio",
      "help": "Mutes game audio while the window is in the background.",
      "choices": [
        {
          "label": "Off",
          "set": {
            "mute_unfocused": "0"
          }
        },
        {
          "label": "On",
          "set": {
            "mute_unfocused": "1"
          }
        }
      ],
      "defaults": {
        "mute_unfocused": "0"
      },
      "in": "main",
      "advanced": false
    },
    {
      "id": "audio_channels",
      "label": "Audio channels",
      "group": "Audio",
      "help": "Speaker channel layout reported to the game audio mixer.",
      "choices": [
        {
          "label": "Auto",
          "set": {
            "audio_channels": "auto"
          }
        },
        {
          "label": "Stereo",
          "set": {
            "audio_channels": "stereo"
          }
        },
        {
          "label": "5.1 Surround",
          "set": {
            "audio_channels": "5.1"
          }
        }
      ],
      "defaults": {
        "audio_channels": "auto"
      },
      "in": "main",
      "advanced": false
    },
    {
      "id": "ui_lang",
      "label": "Overlay language",
      "group": "Language",
      "help": "Language used by the built-in F1 settings overlay.",
      "choices": [
        {
          "label": "Auto (System)",
          "set": {
            "ui_lang": "auto"
          }
        },
        {
          "label": "English",
          "set": {
            "ui_lang": "en"
          }
        },
        {
          "label": "Simplified Chinese",
          "set": {
            "ui_lang": "zh-Hans"
          }
        },
        {
          "label": "Traditional Chinese",
          "set": {
            "ui_lang": "zh-Hant"
          }
        },
        {
          "label": "Japanese",
          "set": {
            "ui_lang": "ja"
          }
        },
        {
          "label": "Korean",
          "set": {
            "ui_lang": "ko"
          }
        }
      ],
      "defaults": {
        "ui_lang": "auto"
      },
      "in": "main",
      "advanced": false
    },
    {
      "id": "game_lang",
      "label": "Game text language",
      "group": "Language",
      "help": "In-game text language (available options depend on your Asia or US/EU copy).",
      "choices": [
        {
          "label": "Auto",
          "set": {
            "game_lang": "auto"
          }
        },
        {
          "label": "Simplified Chinese",
          "set": {
            "game_lang": "zh-Hans"
          }
        },
        {
          "label": "Traditional Chinese",
          "set": {
            "game_lang": "zh-Hant"
          }
        },
        {
          "label": "Korean",
          "set": {
            "game_lang": "ko"
          }
        },
        {
          "label": "English",
          "set": {
            "game_lang": "en-US"
          }
        },
        {
          "label": "French",
          "set": {
            "game_lang": "fr"
          }
        },
        {
          "label": "German",
          "set": {
            "game_lang": "de"
          }
        },
        {
          "label": "Italian",
          "set": {
            "game_lang": "it"
          }
        },
        {
          "label": "Spanish",
          "set": {
            "game_lang": "es"
          }
        },
        {
          "label": "Japanese",
          "set": {
            "game_lang": "ja"
          }
        }
      ],
      "defaults": {
        "game_lang": "auto"
      },
      "in": "main",
      "advanced": false
    },
    {
      "id": "pad_layout",
      "label": "Controller layout",
      "group": "Controls",
      "help": "Maps host controller buttons between Nintendo Switch physical layout and Xbox letter layout (also sets overlay navigation). Note: maps controller layout only and does not replace in-game Switch button icons.",
      "choices": [
        {
          "label": "Nintendo",
          "set": {
            "pad_layout": "nintendo"
          }
        },
        {
          "label": "Xbox (layout only; in-game icons remain Switch)",
          "set": {
            "pad_layout": "xbox"
          }
        }
      ],
      "defaults": {
        "pad_layout": "nintendo"
      },
      "in": "main",
      "advanced": false
    },
    {
      "id": "rumble",
      "label": "Controller rumble",
      "group": "Controls",
      "help": "Enables controller vibration feedback from the game.",
      "choices": [
        {
          "label": "On",
          "set": {
            "rumble": "1"
          }
        },
        {
          "label": "Off",
          "set": {
            "rumble": "0"
          }
        }
      ],
      "defaults": {
        "rumble": "1"
      },
      "in": "main",
      "advanced": false
    },
    {
      "id": "rumble_strength",
      "label": "Rumble strength",
      "group": "Controls",
      "help": "Controller vibration intensity percentage (25 to 100).",
      "slider": {
        "key": "rumble_strength",
        "min": 25,
        "max": 100,
        "step": 5,
        "format": "%d"
      },
      "when": {
        "rumble": "1"
      },
      "defaults": {
        "rumble_strength": "100",
        "rumble": "1"
      },
      "in": "main",
      "advanced": false
    },
    {
      "id": "background_input",
      "label": "Background controller input",
      "group": "Controls",
      "help": "Keep reading controllers when the game window is not focused.",
      "choices": [
        {
          "label": "On",
          "set": {
            "background_input": "1"
          }
        },
        {
          "label": "Off",
          "set": {
            "background_input": "0"
          }
        }
      ],
      "defaults": {
        "background_input": "1"
      },
      "in": "main",
      "advanced": false
    },
    {
      "id": "ls_deadzone",
      "label": "Left stick deadzone",
      "group": "Controls",
      "help": "Radial deadzone percentage (0 to 40) for the left analog stick.",
      "slider": {
        "key": "ls_deadzone",
        "min": 0,
        "max": 40,
        "step": 2,
        "format": "%d"
      },
      "defaults": {
        "ls_deadzone": "12"
      },
      "in": "main",
      "advanced": false
    },
    {
      "id": "rs_deadzone",
      "label": "Right stick deadzone",
      "group": "Controls",
      "help": "Radial deadzone percentage (0 to 40) for the right analog stick.",
      "slider": {
        "key": "rs_deadzone",
        "min": 0,
        "max": 40,
        "step": 2,
        "format": "%d"
      },
      "defaults": {
        "rs_deadzone": "12"
      },
      "in": "main",
      "advanced": false
    },
    {
      "id": "trigger_threshold",
      "label": "Trigger threshold",
      "group": "Controls",
      "help": "Analog trigger activation threshold percentage (10 to 90) for ZL/ZR.",
      "slider": {
        "key": "trigger_threshold",
        "min": 10,
        "max": 90,
        "step": 5,
        "format": "%d"
      },
      "defaults": {
        "trigger_threshold": "50"
      },
      "in": "main",
      "advanced": false
    }
  ],
  "actions": [
    {
      "id": "saves",
      "label": "Saves",
      "help": "Your Switch save folder (save/save_0/).",
      "open": "saves"
    },
    {
      "id": "mods",
      "label": "Mods",
      "help": "LayeredFS mod root (place mod folders inside mods/<mod_name>/romfs/).",
      "open": "mods"
    },
    {
      "id": "logs",
      "label": "Logs",
      "help": "yokaiwatch1recomp.log and recent session backups for bug reports.",
      "open": "logs"
    }
  ]
}
