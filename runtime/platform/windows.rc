// The .exe's icon (Makefile: windres -I docs/icon). ID 1: Explorer and the taskbar use the first icon resource.
1 ICON "icon.ico"
// The application manifest (RT_MANIFEST 24, ID 1): UTF-8 as the process code page - a game files folder, or
// 13SentinelsRecomp's own folder, named with non-ASCII characters wasn't found
1 24 "windows.manifest"

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "13SentinelsRecomp Contributors"
            VALUE "FileDescription",  "13SentinelsRecomp - Static Recompilation Runtime"
            VALUE "FileVersion",      "1.0.0-beta1"
            VALUE "InternalName",     "13SentinelsRecomp"
            VALUE "LegalCopyright",   "MIT License - User-supplied game assets required"
            VALUE "OriginalFilename", "13SentinelsRecomp.exe"
            VALUE "ProductName",      "13SentinelsRecomp"
            VALUE "ProductVersion",   "1.0.0-beta1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
